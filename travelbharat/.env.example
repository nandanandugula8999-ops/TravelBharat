# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/travelbharat?retryWrites=true&w=majority

# Admin credentials (used at login and seed time)
ADMIN_EMAIL=admin@travelbharat.com
ADMIN_PASSWORD=your_secure_password_here

# JWT signing secret — must be at least 32 random characters
JWT_SECRET=replace_me_with_a_32_char_random_secret_here

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
